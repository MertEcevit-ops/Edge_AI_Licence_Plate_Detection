# LwIP build integration — this file is NOT auto-generated by the IDE.
# Loaded via "-include ../makefile.init" before objects.mk.
# Defines LWIP_OBJS and compilation rules.
# USER_OBJS += $(LWIP_OBJS) is in makefile.defs (after objects.mk clears USER_OBJS).

LWIP_ROOT := /home/murat/Videos/edge_ai_alpr/Edge_AI_Licence_Plate_Detection/Middlewares/Third_Party/LwIP/stm32-mw-lwip

LWIP_CFLAGS := \
  -mcpu=cortex-m55 -std=gnu11 -g3 -DDEBUG -DUSE_HAL_DRIVER -DSTM32N657xx -c \
  -I../Core/Inc \
  -I../../Secure_nsclib \
  -I../../Drivers/STM32N6xx_HAL_Driver/Inc \
  -I../../Drivers/CMSIS/Device/ST/STM32N6xx/Include \
  -I../../Drivers/STM32N6xx_HAL_Driver/Inc/Legacy \
  -I../../Drivers/CMSIS/Include \
  -I../../Middlewares/Third_Party/FreeRTOS/Source/include/ \
  -I../../Middlewares/Third_Party/FreeRTOS/Source/portable/GCC/ARM_CM55_NTZ/non_secure/ \
  -I../../Middlewares/Third_Party/FreeRTOS/Source/CMSIS_RTOS_V2/ \
  -I../../Middlewares/Third_Party/CMSIS/RTOS2/Include/ \
  -I../../Middlewares/Third_Party/LwIP/stm32-mw-lwip/src/include/ \
  -I../../Middlewares/Third_Party/LwIP/stm32-mw-lwip/contrib/ports/freertos/include/ \
  -I../../Middlewares/Third_Party/LwIP/stm32-mw-lwip/system/ \
  -O0 -ffunction-sections -fdata-sections -Wall -fstack-usage -fcyclomatic-complexity -mcmse \
  --specs=nano.specs -mfpu=fpv5-d16 -mfloat-abi=hard -mthumb

LWIP_SRCS := \
  $(LWIP_ROOT)/src/api/api_lib.c \
  $(LWIP_ROOT)/src/api/api_msg.c \
  $(LWIP_ROOT)/src/api/err.c \
  $(LWIP_ROOT)/src/api/if_api.c \
  $(LWIP_ROOT)/src/api/netbuf.c \
  $(LWIP_ROOT)/src/api/netdb.c \
  $(LWIP_ROOT)/src/api/netifapi.c \
  $(LWIP_ROOT)/src/api/sockets.c \
  $(LWIP_ROOT)/src/api/tcpip.c \
  $(LWIP_ROOT)/src/core/def.c \
  $(LWIP_ROOT)/src/core/dns.c \
  $(LWIP_ROOT)/src/core/inet_chksum.c \
  $(LWIP_ROOT)/src/core/init.c \
  $(LWIP_ROOT)/src/core/ip.c \
  $(LWIP_ROOT)/src/core/mem.c \
  $(LWIP_ROOT)/src/core/memp.c \
  $(LWIP_ROOT)/src/core/netif.c \
  $(LWIP_ROOT)/src/core/pbuf.c \
  $(LWIP_ROOT)/src/core/raw.c \
  $(LWIP_ROOT)/src/core/stats.c \
  $(LWIP_ROOT)/src/core/sys.c \
  $(LWIP_ROOT)/src/core/tcp.c \
  $(LWIP_ROOT)/src/core/tcp_in.c \
  $(LWIP_ROOT)/src/core/tcp_out.c \
  $(LWIP_ROOT)/src/core/timeouts.c \
  $(LWIP_ROOT)/src/core/udp.c \
  $(LWIP_ROOT)/src/core/ipv4/acd.c \
  $(LWIP_ROOT)/src/core/ipv4/autoip.c \
  $(LWIP_ROOT)/src/core/ipv4/dhcp.c \
  $(LWIP_ROOT)/src/core/ipv4/etharp.c \
  $(LWIP_ROOT)/src/core/ipv4/icmp.c \
  $(LWIP_ROOT)/src/core/ipv4/igmp.c \
  $(LWIP_ROOT)/src/core/ipv4/ip4_addr.c \
  $(LWIP_ROOT)/src/core/ipv4/ip4.c \
  $(LWIP_ROOT)/src/core/ipv4/ip4_frag.c \
  $(LWIP_ROOT)/src/netif/ethernet.c \
  $(LWIP_ROOT)/contrib/ports/freertos/sys_arch.c

LWIP_OBJS := $(patsubst $(LWIP_ROOT)/%.c,./Middlewares/Third_Party/LwIP/stm32-mw-lwip/%.o,$(LWIP_SRCS))

$(LWIP_OBJS): ./Middlewares/Third_Party/LwIP/stm32-mw-lwip/%.o: $(LWIP_ROOT)/%.c
	@mkdir -p $(dir $@)
	arm-none-eabi-gcc "$<" $(LWIP_CFLAGS) -MMD -MP -MF"$(@:%.o=%.d)" -MT"$@" -o "$@"
